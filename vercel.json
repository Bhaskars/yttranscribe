{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "bin/**"
    }
  },
  "headers": [
    {
      "source": "/api/process",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-transform" },
        { "key": "X-Accel-Buffering", "value": "no" }
      ]
    }
  ]
}
