{
  "name": "vaani-transcript-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Paste a YouTube link or upload a video, get a clean transcript translated into Tamil (or 40+ other languages), ready to download or print.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "vercel-build": "node scripts/fetch-ytdlp.mjs",
    "deploy": "vercel --prod"
  },
  "engines": {
    "node": "24.x"
  },
  "keywords": [
    "youtube",
    "transcript",
    "tamil",
    "translation",
    "srt"
  ],
  "license": "MIT"
}
